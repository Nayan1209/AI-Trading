APP_ENV=development
DATABASE_URL=
LOG_LEVEL=INFO

# Lightsail HTTPS dashboard settings (only required by deploy/lightsail/compose.yml).
APP_DOMAIN=dashboard.example.com
TLS_EMAIL=admin@example.com
DASHBOARD_USERNAME=admin
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# The hash contains dollar signs; keep the value single-quoted in .env.
DASHBOARD_PASSWORD_HASH=''

# Groww credentials - placeholders only. Never commit real values.
# Set either a short-lived access token, or both API key and API secret.
GROWW_ACCESS_TOKEN=
GROWW_API_KEY=
GROWW_API_SECRET=
